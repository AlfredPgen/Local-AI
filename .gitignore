# model weights and datasets (hundreds of MB; GitHub refuses files over 100 MB)
*.pt
*.safetensors
*.bin
*.pt.bak-*
datasets/
export*/
exported_model/

# personal run records and local backups (they contain local paths)
experiments.csv
experiments.csv.*
*_metrics.jsonl
*_benchmark_*.csv
compare_*.csv
benchmarks/
tinyGPT_advanced_techniques.docx

# regenerable
__pycache__/
*.pyc
*.prefilter.json
*.docx.previous
*_dashboard.png
*_embeddings.html
log.txt
posttrain_data/
logs/

# dashboards that view_pt.py publishes (the copies next to checkpoints stay ignored)
!dashboards/*_dashboard.png
!results/experiments.csv

# reports that tools/edit_weights.py and tools/compare_edit.py write next to checkpoints (they name local files)
*_edit.json
*_vs_original*
.compile_cache/
*_tokens.png
